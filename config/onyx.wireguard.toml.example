# Onyx Node config with WireGuard as the recorded transport.
# Copy to config/onyx.toml for local use. That file is gitignored.
# Companion guide: docs/WIREGUARD_SETUP.md
#
# Do not put WireGuard PrivateKey material in this file.
# Keys live in /etc/wireguard/ on the host, mode 0600.

[node]
id = "onyx-hannover-01"
plane = "independent"

[pulse]
interval_secs = 30
status_dir = "status"
state_dir = "state"

[mesh]
topic = "nexus/mesh/v0"
# transport = "none" | "tailscale" | "netbird" | "yggdrasil" | "wireguard"
transport = "wireguard"
# fingerprint is a public hint only. never a private key.
# fingerprint = "wg-nexus"

[wizard_q]
enabled = false
mode = "dry-run"
